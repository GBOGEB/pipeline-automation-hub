{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbo.example/lsaf/event.schema.json",
  "title": "LSAF Event Receipt",
  "type": "object",
  "required": ["schema", "event_id", "session_id", "observed_at", "class", "semantic_key", "authority"],
  "properties": {
    "schema": {"const": "lsaf/event/v0.1"},
    "event_id": {"type": "string"},
    "session_id": {"type": "string"},
    "observed_at": {"type": "string", "format": "date-time"},
    "class": {"type": "string"},
    "subclass": {"type": ["string", "null"]},
    "semantic_key": {
      "type": "object",
      "required": ["epic", "topic"],
      "properties": {
        "epic": {"type": "string"},
        "topic": {"type": "string"},
        "object": {"type": ["string", "null"]}
      }
    },
    "state_transition": {
      "type": "object",
      "properties": {
        "from": {"type": ["string", "null"]},
        "to": {"type": ["string", "null"]}
      }
    },
    "evidence": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "required": ["source", "transfer"],
      "properties": {
        "source": {"type": "string"},
        "transfer": {"const": false}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": true
}
