{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gbo.example/lsaf/prediction.schema.json",
  "title": "LSAF N+1 Prediction Receipt",
  "type": "object",
  "required": ["schema", "prediction_id", "source_state", "predicted", "confidence", "made_at"],
  "properties": {
    "schema": {"const": "lsaf/prediction/v0.1"},
    "prediction_id": {"type": "string"},
    "made_at": {"type": "string", "format": "date-time"},
    "source_state": {"type": "object"},
    "predicted": {
      "type": "object",
      "required": ["next_state"],
      "properties": {
        "next_state": {"type": "string"},
        "next_blocker": {"type": ["string", "null"]},
        "next_repo": {"type": ["string", "null"]},
        "runs_to_boundary": {"type": ["integer", "null"], "minimum": 0},
        "commits_to_boundary": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "outcome": {
      "type": ["object", "null"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "next_state": {"type": "string"},
        "next_blocker": {"type": ["string", "null"]}
      }
    },
    "score": {
      "type": ["object", "null"],
      "properties": {
        "top1_correct": {"type": "boolean"},
        "top3_correct": {"type": "boolean"},
        "brier": {"type": ["number", "null"]},
        "false_ready": {"type": ["boolean", "null"]},
        "false_blocked": {"type": ["boolean", "null"]}
      }
    }
  },
  "additionalProperties": true
}
