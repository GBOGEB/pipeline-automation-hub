{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codepurple.metric-ledger.measurement.v1",
  "title": "CODE PURPLE evidence-bound metric observation",
  "type": "object",
  "required": ["id", "scope_id", "metric", "step", "state", "repo", "unit"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "metric": {"type": "string", "minLength": 1},
    "step": {"type": "integer"},
    "state": {"enum": ["OBSERVED_NATIVE", "REPORTED_HISTORICAL", "DERIVED", "SIMULATED"]},
    "repo": {"type": "string"},
    "unit": {"type": "string"},
    "numerator": {"type": ["number", "null"], "minimum": 0},
    "denominator": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "value": {"type": ["number", "null"]},
    "sha": {"type": ["string", "null"]},
    "run_id": {"type": ["integer", "null"]},
    "run_attempt": {"type": ["integer", "null"]},
    "job_id": {"type": ["integer", "null"]},
    "artifact_id": {"type": ["integer", "null"]},
    "population_key": {"type": ["string", "null"]},
    "tool_version": {"type": ["string", "null"]},
    "coverage_config_sha": {"type": ["string", "null"]},
    "worker_hours": {"type": ["number", "null"], "minimum": 0},
    "source": {"type": ["string", "null"]},
    "root_id": {"type": ["string", "null"]},
    "fingerprint": {"type": ["string", "null"]},
    "severity": {"enum": ["P0", "P1", "P2", "P3", "UNKNOWN", null]},
    "observed_at": {"type": "string"},
    "note": {"type": ["string", "null"]}
  },
  "additionalProperties": true,
  "$comment": "JSON Schema is descriptive. Runtime Python performs scope and numeric checks. Missing denominators remain null/omitted; never zero-filled."
}
