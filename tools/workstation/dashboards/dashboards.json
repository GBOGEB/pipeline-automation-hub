{
  "schema": "gbogeb.pc-dashboards.config.v1",
  "note": "Edit this file to pin dashboards or add scan folders, then run REFRESH.cmd. scan_roots paths accept ~ and glob patterns. Install-Dashboards.ps1 copies this file to the install folder only when none is there, so your edits survive reinstalls.",
  "scan_roots": [
    {
      "path": "~",
      "depth": 1
    },
    {
      "path": "~/Documents",
      "depth": 2
    },
    {
      "path": "~/Documents/Codex",
      "depth": 3
    },
    {
      "path": "~/OneDrive - *",
      "depth": 2
    }
  ],
  "include_claude_worktrees": false,
  "skip_dirs": [
    "node_modules",
    "AppData",
    ".venv",
    "venv",
    "site-packages",
    "__pycache__",
    ".cache",
    ".tox",
    "htmlcov",
    ".pytest_cache"
  ],
  "skip_html_patterns": [
    "node_modules/",
    "htmlcov/",
    "site-packages/",
    "/fixtures/",
    "/test_data/",
    "_template.html",
    "/templates/"
  ],
  "entry_name_pattern": "(^|/)(index|home)\\.html?$|launcher|dashboard|portal|landing|cockpit|hub|_current|navigator|tracker|burndown",
