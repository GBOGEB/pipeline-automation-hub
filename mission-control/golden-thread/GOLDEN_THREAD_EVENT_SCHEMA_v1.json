{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "missioncontrol.golden_thread_ledger.v1",
  "title": "MissionControl Golden Thread ledger v1",
  "type": "object",
  "required": ["schema", "projection_schema_version", "authority_transfer", "events"],
  "properties": {
    "schema": {"const": "missioncontrol.golden_thread_ledger.v1"},
    "projection_schema_version": {"const": 1},
    "authority_transfer": {"const": false},
    "head_event_digest": {"type": "string"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seq", "event_id", "event_type", "occurred_at", "recorded_at", "actor",
          "subject_ref", "authority_domain", "evidence_class", "evidence_refs",
          "non_compensating_preserved", "projection_schema_version",
          "previous_event_digest", "this_event_digest"
        ],
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "event_id": {"type": "string", "minLength": 1},
          "event_type": {
            "enum": [
              "OBSERVED", "BOOTSTRAP_RECONSTRUCTED", "CLASSIFIED", "ROOT_CREATED",
              "ATTACHED_TO_ROOT", "WORK_ORDER_CREATED", "CAMPAIGN_ATTACHED",
              "MERGED_INTO", "SPLIT_FROM", "SUPERSEDED_BY", "INVALIDATED", "REOPENED",
              "STATE_CHANGED", "CONTROL_PROMOTED", "EVIDENCE_ADDED",
              "AUTHORITY_BOUNDARY_ASSERTED", "NON_COMPENSATING_GATE_SET",
              "RETIREMENT_CANDIDATE"
            ]
          },
          "occurred_at": {"type": "string"},
          "recorded_at": {"type": "string"},
          "actor": {"type": "string"},
          "subject_ref": {"type": "string"},
          "from_ref": {"type": ["string", "null"]},
          "to_ref": {"type": ["string", "null"]},
          "authority_domain": {"type": "string"},
          "evidence_class": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"},
          "payload": {"type": "object"},
          "source_sha": {"type": "string"},
          "source_snapshot_digest": {"type": "string"},
          "non_compensating_preserved": {"type": "boolean"},
          "observed_source_timestamp": {"type": "string"},
          "reconstruction_timestamp": {"type": "string"},
          "reconstruction_method": {"type": "string"},
          "projection_schema_version": {"const": 1},
          "previous_event_digest": {"type": "string"},
          "this_event_digest": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
