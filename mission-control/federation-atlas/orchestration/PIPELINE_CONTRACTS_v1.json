  "joins": [
    {
      "from": "source-contracts:check",
      "to": "repo-inventory:check",
      "kind": "ARTIFACT_HANDOFF",
      "join": "ALL",
      "binding": "LOCAL_CONTRACT"
    },
    {
      "from": "repo-inventory:inventory",
      "to": "source-model:inventory",
      "kind": "ARTIFACT_HANDOFF",
      "join": "ALL",
      "binding": "LOCAL_CONTRACT"
    },
    {
      "from": "source-model:model",
      "to": "orchestration-view:model",
      "kind": "ARTIFACT_HANDOFF",
      "join": "ALL",
      "binding": "LOCAL_CONTRACT"
    },
    {
      "from": "method-atlas:html",
      "to": "pages-portal:method-html",
      "kind": "ARTIFACT_HANDOFF",
      "join": "ALL",
      "binding": "LOCAL_CONTRACT"
    },
    {
      "from": "orchestration-view:html",
      "to": "pages-portal:execution-html",
      "kind": "ARTIFACT_HANDOFF",
      "join": "ALL",
      "binding": "LOCAL_CONTRACT"
    },
    {
      "from": "coverage-observations:metrics",
      "to": "source-model:coverage",
      "join": "ALL",
      "kind": "ARTIFACT_HANDOFF"
    },
    {
      "from": "broker-plan:plan",
      "to": "source-model:plan",
      "join": "ALL",
      "kind": "ARTIFACT_HANDOFF"
    }
  ],
  "io_rules": {
    "actor_continuity": "Customer may become the next supplier; actor continuity alone does not validate an artifact handoff.",
    "artifact_continuity": "Every O-to-I handoff checks port kind and schema where specified, required cardinality, source identity and output bytes.",
    "joins": "ALL requires every predecessor output. ANY is permitted only if the consumer explicitly declares equivalent alternatives.",
    "feedback": "Feedback is next-pulse evidence, excluded from same-pulse executable needs.",
    "failure": "Missing or malformed required output blocks descendants even when the process exit status is zero.",
    "scope": "Profile dependencies describe data/build relationships. Actual local scheduling uses registered task adapters; a diagram does not dispatch remote work.",
    "ports": "Function results are typed in-memory ports; main.py serializes them at the declared artifact paths. Adapters invoke existing generators with their real CLI parameters."
  }
}
