      "observed_at_utc": null
    },
    {
      "id": "EXACT_HEAD_PROOF_YIELD",
      "label": "Exact-head proof yield",
      "category": "EVIDENCE_QUALITY",
      "unit": "ratio",
      "statistic": "RATIO",
      "definition": "exact-source admitted head proofs that fully satisfy declared gate set divided by terminal eligible exact-head proof attempts",
      "numerator": "eligible_terminal_exact_head_proofs_all_required_checks_green",
      "denominator": "eligible_terminal_exact_head_proof_attempts",
