        "materiality",
        "window_start_utc",
        "window_end_utc"
      ],
      "min_comparability": "dedupe retries by incident/root identity; record zero-step habitat events separately",
      "current_value": null,
      "evidence_state": "UNBOUND",
      "observed_at_utc": null
    },
