      "definition": "95th percentile of admitted runner queue wait",
      "observation": "run_started_at_utc - created_at_utc, only when both timestamps observed",
      "numerator": null,
      "denominator": "eligible executed runs with comparable timestamps within time window",
      "source_owner": "MISSION_CONTROL_RUNNER_TELEMETRY",
