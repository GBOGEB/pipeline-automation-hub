      "label": "Accepted receipt yield",
      "category": "FEDERATION_PROOF",
      "unit": "ratio",
      "statistic": "RATIO",
      "definition": "accepted receipts divided by all terminally adjudicated receipts, with deferred and rejected separately displayed",
      "numerator": "accepted_terminal_receipts",
      "denominator": "accepted_terminal_receipts + rejected_terminal_receipts + deferred_terminal_receipts",
