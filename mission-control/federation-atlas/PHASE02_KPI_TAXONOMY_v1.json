      "label": "Runner health",
      "category": "RUNTIME_CAPACITY",
      "unit": "ratio",
      "statistic": "RATIO",
      "definition": "eligible admitted runner instances with recent healthy heartbeat divided by eligible runners; report offline and unknown counts separately",
      "numerator": "eligible_runner_instances_with_fresh_healthy_heartbeat",
      "denominator": "total_eligible_admitted_runner_instances",
