        "consumer_id",
        "disposition",
        "adjudicated_at_utc",
        "window_start_utc",
        "window_end_utc"
      ],
      "min_comparability": "exclude pending and unidentified consumers from terminal denominator; no denominator means null",
      "current_value": null,
      "evidence_state": "UNBOUND",
      "observed_at_utc": null
    },
