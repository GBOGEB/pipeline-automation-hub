      "id": "PREDICTION_VS_ACTUAL",
      "label": "Prediction vs actual",
      "category": "ADVISORY_FORECAST",
      "unit": "metric_family",
      "statistic": "MAE_AND_BRIER",
      "definition": "pre-outcome predictions paired by identity with later observed outcomes; report time MAE (seconds) and first-red Brier score independently",
      "numerator": "sum(abs(predicted_duration-observed_duration)) / n and mean((predicted_probability-observed_binary_event)^2)",
      "denominator": "paired valid out-of-sample forecasts (report n and scope separately for each submetric)",
      "source_owner": "DOW_STATISTICAL_DIAGNOSTICS",
      "required_fields": [
        "forecast_id",
        "issued_at_utc",
        "outcome_observed_at_utc",
        "source_sha",
        "scope",
        "prediction_type",
        "predicted_value",
        "observed_value",
        "window_start_utc",
        "window_end_utc"
      ],
      "min_comparability": "no combined 92% prediction accuracy without registered metric; prediction never grants admission",
      "current_value": null,
      "evidence_state": "UNBOUND",
      "observed_at_utc": null
