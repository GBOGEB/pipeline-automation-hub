        "window_start_utc",
        "window_end_utc"
      ],
      "min_comparability": "same declared gate family, terminal only; pending/skipped/zero-step and unbound review remain separate, never green",
      "current_value": null,
      "evidence_state": "UNBOUND",
      "observed_at_utc": null
    },
    {
      "id": "FIRST_RED_COUNT",
      "label": "First material red count",
      "category": "DEFECT_OBSERVABILITY",
      "unit": "incidents",
      "statistic": "COUNT",
      "definition": "distinct materially observed first-red root incidents in the window",
      "numerator": "distinct observed material first-red incident keys",
      "denominator": "report time window and scanned admitted heads; this is a count, not a proportion",
      "source_owner": "FIRST_RED_REX_CONTROL",
      "required_fields": [
        "repository",
        "source_sha",
        "failure_family",
        "incident_id",
        "observed_at_utc",
