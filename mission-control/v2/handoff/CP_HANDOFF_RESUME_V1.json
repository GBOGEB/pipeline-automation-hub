      "alias": "CP.RESUME!",
      "kind": "CHAT_INSTRUCTION_MACRO",
      "meaning": "Reconstitute handover state from supplied bytes then independently requalify current sources before performing the next admissible bounded action.",
      "input": {
        "bundle": "ATTACHED_VERIFIABLE_HANDOVER_ZIP",
        "mode": "VERIFY_REFRESH_EXECUTE",
        "horizon": "G3P:N_TO_N_PLUS_3"
      },
      "must_do": [
        "REQUIRE_ATTACHED_ARCHIVE_OR_ACCESSIBLE_SOURCE",
        "VERIFY_ARCHIVE_MANIFEST",
        "READ_START_HERE_HANDOVER_CURRENT_STATE_METHOD",
        "RECONCILE_LIVE_GITHUB_DEFAULT_AND_PR_HEADS",
        "KEEP_PREVIOUS_RUNS_HISTORICAL",
        "CLASSIFY_FIRST_RED_AND_DISJOINT_LEASES",
        "CONTINUE_ONE_G3P_WAVE_ONLY_IF_SAFE",
        "REPORT_ACTUAL_N_TO_N_PLUS_3_OR_EARLY_STOP",
        "NO_BACKGROUND_PROMISE"
      ],
      "output": [
        "SOURCE_AND_GATE_RECENSUS",
