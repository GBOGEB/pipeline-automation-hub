        "ACTUAL_TEST_AND_COVERAGE_DENOMINATORS",
        "BLOCKERS_AND_NEXT_OWNER",
        "OPTIONAL_NEXT_HANDOFF"
      ]
    },
    "G3P.EXECUTE": {
      "display": "G3P.EXECUTE(N,N+3)",
      "kind": "CHAT_INSTRUCTION_MACRO",
