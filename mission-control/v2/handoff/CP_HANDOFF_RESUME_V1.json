      "output": [
        "START_HERE.md",
        "LOSSLESS_HANDOVER.md",
        "DROPIN_NEXT_CHAT.md",
        "state.json",
        "pr_heads_and_runs.json",
        "root_blocker_queue.json",
        "method_contract.md",
        "metric_ledger.csv",
        "MANIFEST.json",
        "MANIFEST_SHA256.txt",
        "ZIP_FILE_AND_EXTERNAL_SHA256"
      ]
    },
