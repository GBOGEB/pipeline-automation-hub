{
  "schema": "missioncontrol.mission_reporting_standard.v3",
  "scope": ["GM-I", "GM-II", "GM-III", "GM-IV", "GM-V", "V+", "MISSION_H1", "MISSION_H2", "MISSION_H3", "MISSION_H4"],
  "purpose": "make every mission report comparable for breadth, depth, history, runtime, crew learning, parent-child lineage, resource pressure and reinforcement decisions",
  "required_sections": {
    "identity": ["mission_id", "mission_name", "parent_mission_id", "child_mission_ids", "state", "lifecycle_stage", "authority_owner", "report_sha", "as_of"],
    "coverage": ["repos_in_scope", "repos_seen", "breadth_level_B", "breadth_fraction_b", "subrepos_discovered", "hidden_surfaces_discovered", "coverage_gaps"],
    "penetration": ["penetration_level_P", "depth_fraction_d", "Pen_bxd", "max_tree_depth_observed", "nested_boundaries_resolved", "unresolved_strata"],
    "history": ["commit_history_read", "pr_history_read", "branch_ancestry_read", "commits_examined", "prs_examined", "merge_lineage", "reverts_supersessions", "historical_first_reds", "historical_rex_recurrence", "unresolved_lineage_edges"],
    "runtime": ["runtime_level_R", "runtime_paths_identified", "runtime_paths_proven", "exact_sha_runs", "repeat_runs", "failure_paths_observed", "queue_time", "execute_time", "runner_state"],
    "decomposition": ["nodes", "edges", "atoms_or_modules", "dependency_cycles", "critical_paths", "orphan_or_floating_nodes", "fan_in_fan_out", "unresolved_dependencies", "temporal_lineage_graph"],
    "workflow_representation": ["ascii_view", "mermaid_view", "state_or_sequence_view", "feedback_feedforward_edges", "genealogy_view", "diagram_source_sha"],
    "crew": ["crew_active", "crew_peak", "role_mix", "crew_depth_summary", "historian_depth", "secondments", "effective_worker_capacity", "coordination_drag", "reinforcement_recommendation"],
    "rex": ["rex_in", "rex_learned", "rex_generated", "rex_reused", "rex_rejected", "rex_recurrence", "rex_consumers", "doctrine_changes", "historical_rex_sources"],
    "lineage": ["parent_nodes", "child_nodes", "ancestor_depth", "descendant_count", "floating_children", "superseded_children", "cross_mission_children", "lineage_complete"],
    "federation": ["producer_edges", "consumer_edges", "cross_mission_dependencies", "feedforward", "feedback", "conflicts_challenges"],
    "analytics": ["PCA_features_observed", "PCA_features_seeded", "BT_pairs_observed", "pressure_vector", "resource_allocation_basis", "lineage_complexity_features", "rex_recurrence_features"],
    "contract": ["zod_contract_version", "validation_state", "validation_errors", "schema_source_sha"],
    "verification": ["DoV_state", "DoD_state", "first_red", "blocked_by", "next_bounded_action", "evidence_class", "exact_source_refs"]
  },
  "crew_depth_reporting": {
    "report_per_crew_member": ["crew_id", "roles", "role_depth", "repo_familiarity", "mission_familiarity", "historical_familiarity", "runtime_proof_depth", "evidence_depth", "rex_depth", "cross_mission_depth", "tool_readiness", "availability", "effective_capacity", "last_evidence_sha"],
    "historian_specific": ["commit_history_depth", "pr_history_depth", "merge_lineage_depth", "rex_history_depth", "lineage_edges_verified"],
    "no_synthetic_scores": "numeric crew-depth values require observed receipts, accepted work or explicit expert-seeded classification"
  },
  "parent_child_contract": {
    "source": "PARENT_CHILD_LINEAGE_CONTRACT_v1.json",
    "rule": "every non-root child resolves to a parent and authority inheritance is false unless explicitly declared"
  },
  "zod_contract": {
    "source": "contracts/mission_report.zod.ts",
    "required_for_control_promotion": true,
    "required_for_measured_PCA_BT_ingest": true
  },
  "visual_contract": {
    "minimum_ascii": "mission -> parent/children -> MissionControl -> consumers plus first-red and next action",
    "minimum_mermaid": "state or flow diagram with feedback/feedforward and genealogy directions",
    "calligrapher_owner": true,
    "neuron_graph_input": true,
    "historian_temporal_input": true
  },
  "anti_overclaim": [
    "breadth does not imply depth",
    "Pen does not imply runtime",
    "diagram completeness does not imply execution",
    "crew headcount does not equal effective capacity",
    "REX volume does not equal REX value",
    "merge history does not imply runtime success",
    "historical inference must not be labeled observed"
  ]
}
