{
  "schema": "missioncontrol.federation.return_packet.v3",
  "status": "CANDIDATE_CANONICAL_PROTOCOL",
  "authority_transfer": false,
  "required": [
    "mission_id", "parent_mission_id", "child_entity_ids", "repo", "crew", "exact_head",
    "evidence_class", "observation_class", "lineage", "historical_lineage", "capabilities",
    "coverage", "penetration", "decomposition", "runtime_surface", "runtime_evidence",
    "workflow_representation", "crew_depth", "resource_telemetry", "authority_boundary",
    "risk", "novelty", "overlap", "rex_in", "rex_out", "rex_reuse", "consumer_edges",
    "next_bounded_action", "pca_eligibility", "bt_eligibility", "contract_validation",
    "freshness", "disposition"
  ],
  "coverage_fields": ["breadth_level_B", "breadth_fraction_b", "surfaces_seen", "surfaces_discovered", "coverage_gaps"],
  "penetration_fields": ["penetration_level_P", "depth_fraction_d", "Pen_bxd", "max_tree_depth", "hidden_surfaces", "nested_boundaries"],
  "decomposition_fields": ["nodes", "edges", "atoms_or_modules", "cycles", "orphans", "critical_paths", "dependency_pressure", "temporal_lineage_graph"],
  "runtime_fields": ["runtime_level_R", "paths_identified", "paths_proven", "exact_sha_runs", "repeat_runs", "failure_paths", "queue_time", "execute_time"],
  "crew_depth_fields": ["crew_id", "roles", "role_depth", "repo_familiarity", "mission_familiarity", "historical_familiarity", "runtime_proof_depth", "evidence_depth", "rex_depth", "cross_mission_depth", "tool_readiness", "crew_depth_score_CD", "evidence_basis"],
  "resource_fields": ["availability", "task_role_match", "evidence_confidence", "coordination_drag", "effective_worker_capacity_EWC", "team_EWC", "mission_pressure_MP", "reinforcement_need_RN", "role_shortfall_vector", "recommended_reinforcement", "actual_reinforcement_effect"],
  "historical_lineage_fields": ["commit_history_state", "pr_history_state", "merge_lineage_state", "commits_examined", "prs_examined", "historian_observation_class", "superseded_or_reverted", "historical_first_reds", "historical_rex_refs", "unresolved_lineage_edges"],
  "contract_validation_fields": ["parent_child_contract_version", "zod_contract_version", "validation_state", "validation_errors", "schema_source_sha"],
  "observation_class_enum": ["OBSERVED", "INFERRED", "PROPOSED"],
  "evidence_class_enum": ["EXACT_SHA_RUNTIME", "EXACT_SHA_SOURCE", "REPO_METADATA", "SEMANTIC_READ", "REFERENCE_ONLY"],
  "disposition_enum": ["ACCEPT_SCOUT", "ACCEPT_READER", "DEFER", "REPLACE", "REJECT", "REFERENCE_ONLY", "PARK", "PRUNE_REVIEW"],
  "consumer_effect_enum": ["SPEED", "RISK", "QUALITY", "COST", "COVERAGE", "CONTROL", "CREW_LEARNING", "REINFORCEMENT", "LINEAGE_CONFIDENCE"],
  "rules": [
    "all_governed_cross_feed_routes_through_MissionControl",
    "downstream_use_must_not_strengthen_upstream_authority",
    "future_mission_consumption_does_not_equal_launch_or_assignment",
    "only_observed_provenance_bound_rows_are_measured_PCA_or_BT_eligible",
    "conflicts_route_to_KEB_challenge_and_H4_first_red",
    "crew_secondments_return_REX_and_competency_evidence_to_home_base",
    "crew_depth_updates require observed accepted/rejected work or explicit SEEDED status",
    "reinforcement is calculated from role shortfall and effective capacity, never raw headcount alone",
    "historian_reads_commit_PR_and_merge_history_when lineage affects authority recurrence or resource decisions",
    "historical inference remains distinct from observed Git objects",
    "every non-root child resolves to a parent under the parent-child lineage contract",
    "a_complete_return_declares_at_least_one_consumer_edge_or_NO_CROSS_FEED_JUSTIFIED"
  ]
}
