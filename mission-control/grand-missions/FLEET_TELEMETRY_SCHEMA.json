{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"qps.grand_mission_fleet_telemetry.v1",
  "type":"object",
  "required":["schema","rows"],
  "properties":{
    "schema":{"const":"qps.grand_mission_fleet_telemetry.v1"},
    "rows":{
      "type":"array",
      "items":{
        "type":"object",
        "required":["mission_id","pulse_id","evidence_class","source_sha","queue_seconds","execute_seconds","executed_steps","frontier_count","active_crew_units","accepted_receipts","rejected_receipts","deferred_receipts"],
        "properties":{
          "mission_id":{"enum":["GM-I","GM-II","GM-III","GM-IV","GM-V"]},
          "pulse_id":{"type":"string","minLength":1},
          "evidence_class":{"const":"MEASURED"},
          "source_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
          "queue_seconds":{"type":"number","minimum":0},
          "execute_seconds":{"type":"number","minimum":0},
          "executed_steps":{"type":"integer","minimum":0},
          "frontier_count":{"type":"integer","minimum":1},
          "active_crew_units":{"type":"number","minimum":0},
          "returned_crew_units":{"type":"number","minimum":0},
          "scout_count":{"type":"integer","minimum":0},
          "reader_count":{"type":"integer","minimum":0},
          "specialist_count":{"type":"integer","minimum":0},
          "accepted_receipts":{"type":"integer","minimum":0},
          "rejected_receipts":{"type":"integer","minimum":0},
          "deferred_receipts":{"type":"integer","minimum":0},
          "first_red_count":{"type":"integer","minimum":0},
          "rework_count":{"type":"integer","minimum":0},
          "federation_edges":{"type":"integer","minimum":0},
          "crew_wait_loss":{"type":"number","minimum":0},
          "recurrence_burden":{"type":"number","minimum":0},
          "dov_unlock":{"type":"number","minimum":0}
        },
        "additionalProperties":false
      }
    }
  },
  "additionalProperties":false,
  "pca_gate":{
    "minimum_comparable_rows":3,
    "minimum_distinct_missions":2,
    "evidence_class_required":"MEASURED",
    "reject":["EXPERT_SEEDED","SYNTHETIC","USER_MANDATED_AS_MEASUREMENT"],
    "rule":"ROW_COUNT_ALONE_IS_NOT_SAMPLE_ADEQUACY"
  }
}
