  "qualifiers": [
    {
      "class": "wave",
      "pattern": "^W\\d+[A-Z0-9]*(-[A-Z0-9.]+)*$"
    },
    {
      "class": "pulse",
      "pattern": "^N(\\+)?\\d+([\\-–]N?\\+?\\d+)?$"
    },
    {
      "class": "jade-step",
      "pattern": "^J\\d+$"
    },
    {
      "class": "gate-phase",
      "pattern": "^G\\d+[A-Z]{0,2}$"
    },
    {
      "class": "user-ticket",
      "pattern": "^U\\d+$"
    },
    {
      "class": "priority-phase",
      "pattern": "^P\\d+[A-Z0-9.]*$"
    },
    {
      "class": "fleet-step",
      "pattern": "^F\\d+$"
    },
    {
      "class": "round",
      "pattern": "^R\\d+$"
    },
    {
      "class": "version",
      "pattern": "^(v\\d+(\\.\\d+)*|\\d+\\.\\d+(\\.\\d+)*)$"
    },
    {
      "class": "program",
      "pattern": "^(GM|LM|HM|CPQ|COV|MC)-?\\d+[A-Z]?$"
    },
    {
      "class": "ticket",
      "pattern": "^[A-Z]{2,6}-\\d{1,4}[A-Z]?$"
    },
    {
      "class": "pr-ref",
      "pattern": "^(PR-?|#)\\d+$"
    },
    {
      "class": "rank",
      "pattern": "^rank\\d+$"
    }
  ],
  "type_keywords": [
    [
      "fix",
      "\\b(ci failure|fail(s|ed|ing|ure|ures)?|broken|bugs?|errors?|regression|crash(es)?|red|repair|fix(es|ed)?|stale|missing|wrong|incorrect)\\b"
    ],
    [
      "revert",
      "\\brevert(s|ed)?\\b"
    ],
    [
      "test",
      "\\b(tests?|testing|repeat pass|acceptance|qa|verify|verification|validate|validation|probe|proof)\\b"
    ],
    [
      "docs",
      "\\b(docs?|readme|guide|handbook|write-?up|documentation|explainer)\\b"
    ],
    [
      "ci",
      "\\b(workflows?|pipelines?|runners?|actions|required (check|status))\\b"
    ],
    [
      "refactor",
      "\\b(refactor\\w*|restructur\\w*|renam\\w*|consolidat\\w*|migrat\\w*|dedup\\w*)"
    ],
    [
      "perf",
      "\\b(perf|performance|faster|latency|speed ?up)\\b"
    ],
    [
      "chore",
      "\\b(housekeeping|cleanup|clean up|bump|void|duplicate|accidental|placeholder|archive|purge|rotate|close #\\d+)\\b"
    ],
    [
      "plan",
      "\\b(tracker|epic|waves?|plan|roadmap|backlog|rfi|decide|intake|phase \\d+|program|mission|triage|lane|register)\\b"
    ],
    [
      "feat",
      "\\b(add(s|ed)?|introduce[sd]?|implement\\w*|new|support|enable[sd]?|launch\\w*)\\b"
    ]
  ],
  "notes": {
    "explicit_only": "An alias starting with '=' matches only inside an explicit type(scope) prefix or a label, never in free-text keyword inference (too generic).",
    "qualifiers": "Qualifier patterns match case-insensitively; a token that is a known scope alias stays a scope.",
    "generic": "Generic (cross-cutting) families lose to domain families when a scope is inferred from free text."
  },
  "label_types": {
    "bug": "fix",
    "enhancement": "feat",
    "feature": "feat",
    "documentation": "docs",
    "docs": "docs",
    "dependencies": "build",
    "ci": "ci",
    "test": "test",
    "tests": "test",
    "refactor": "refactor",
    "performance": "perf",
    "chore": "chore",
    "question": "plan",
    "epic": "plan",
    "tracker": "plan",
    "rfi": "plan"
  }
}