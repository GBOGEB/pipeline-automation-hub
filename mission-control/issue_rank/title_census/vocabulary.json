{
  "schema": "gbogeb.title-taxonomy.vocabulary/1.0",
  "grammar": "<type>(<scope>[,<scope>][ <qualifier>...])[!]: <subject>",
  "levels": [
    "type_family  e.g. defect",
    "type         e.g. fix",
    "family       e.g. jade-devops (the cluster a scope belongs to)",
    "scope        e.g. census",
    "qualifier    e.g. N12 (wave / pulse / step markers)",
    "prefix       type(scope) concatenated, e.g. fix(census)"
  ],
